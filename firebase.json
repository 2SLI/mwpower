{
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/nicepay/confirm",
        "function": {
          "functionId": "nicepayConfirm",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/api/nicepay/webhook",
        "function": {
          "functionId": "nicepayWebhook",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "/api/nicepay/sync",
        "function": {
          "functionId": "nicepaySyncPayment",
          "region": "asia-northeast3"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
