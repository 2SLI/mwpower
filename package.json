{
  "name": "mwpower",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run inventory:generate && npm run prices:generate",
    "dev": "vite",
    "dev:functions": "firebase emulators:start --only functions",
    "prebuild": "npm run inventory:generate && npm run prices:generate",
    "build": "vite build && npm run catalog:copy",
    "preview": "vite preview",
    "inventory:generate": "node scripts/generate-product-inventory.mjs",
    "prices:generate": "node scripts/generate-product-prices.mjs",
    "catalog:generate": "node scripts/generate-folder-catalog-manifest.mjs",
    "catalog:copy": "node scripts/copy-catalog-assets.mjs",
    "catalog:flatten": "node scripts/flatten-catalog-assets.mjs",
    "catalog:download:spec": "node scripts/download-meanwell-spec-pdfs.mjs",
    "catalog:download:spec:all": "node scripts/download-meanwell-spec-pdfs.mjs --all-missing",
    "catalog:download:spec:all:canonical": "node scripts/download-meanwell-spec-pdfs.mjs --all-missing --canonical-name",
    "catalog:generate:model-options": "node scripts/generate-model-option-wattage-map.mjs",
    "catalog:local:rebuild": "node scripts/generate-local-leaf-tree-fallback.mjs",
    "catalog:seed:leaf-trees": "node scripts/seed-leaf-model-trees.mjs",
    "catalog:seed:model-assets": "node scripts/seed-model-assets.mjs",
    "catalog:seed:model-assets:storage": "node scripts/seed-model-assets-storage.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.1",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "firebase": "^12.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-pdf": "^10.4.1"
  }
}
